{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/dependencies.schema.json",
  "title": "Pinned assets embedded into the standalone HTML",
  "type": "object",
  "required": ["dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "package", "version", "assets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "package": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string" },
          "homepage": { "type": "string" },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "path"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
                "path": { "type": "string", "minLength": 1 },
                "mime": { "type": "string" },
                "stripSourceMapComment": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
